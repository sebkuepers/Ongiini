# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret — used to verify the X-Hub-Signature-256 header on
# incoming webhook POSTs. Find under: Meta dashboard → App → App settings
# → Basic → App Secret. Required in production; leaving it empty makes
# the webhook accept unsigned requests (dev only).
WHATSAPP_APP_SECRET=

# Tavily Web Search
TAVILY_API_KEY=

# vLLM (running on host, OpenAI-compatible)
# Default points at the Gemma 4 26B A4B NVFP4 container on the DGX Spark.
VLLM_BASE_URL=http://host.docker.internal:8124/v1
VLLM_MODEL=gemma-4-26b

# Storage
DATA_DIR=/data

# Comma-separated MSISDNs (no +) that bypass the Namibia filter
WHITELIST=491702372987

# Public display number on the website (international format, no +)
PUBLIC_WHATSAPP_NUMBER=

# Cloudflare — used locally by `wrangler pages deploy` to push the website
# to the `ongiini` Pages project. Create a token at
# https://dash.cloudflare.com/profile/api-tokens with scope
# `Account → Cloudflare Pages → Edit` restricted to this account.
# Not consumed by the webhook container — local tooling only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
