# Common Intelligence Foundation site — kept local only until the foundation
# is formally established. Deployed directly to Cloudflare Pages via wrangler.
foundation/

# data/ is the production bind-mount: user histories, mem0, logs, mining
# output. Ignore everything and allowlist only files that are meant to be
# public. Anything derived from user messages or unreleased references
# belongs in data/private/ and must never be allowlisted.
data/*
!data/.gitkeep
!data/corpus_sources.md
!data/eval_v2_retained_v1.tsv
!data/oshiwambo_eval/
!data/oshiwambo_eval_v2.tsv
!data/oshiwambo_eval_v3.tsv
!data/oshiwambo_eval_v*_seeds.md

# experimental.ongiini.ai: runtime data and the generated page (scripts/build_experimental_chat.py)
/data-experimental/
/deploy/experimental/site/
