        "type": "dashboard"
      }
    ]
  },
  "description": "Ongiini on Spark — host, containers, inference, leak signals. v1.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Spark host — at a glance",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Load avg (1m)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "cfhyzy3slg1dsf"},
      "targets": [{"expr": "node_load1", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 8},
              {"color": "red", "value": 16}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Memory used",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "cfhyzy3slg1dsf"},
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 75},
              {"color": "red", "value": 90}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "type": "stat",
      "title": "Root disk used",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "cfhyzy3slg1dsf"},
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 85}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "type": "stat",
      "title": "Host uptime",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "cfhyzy3slg1dsf"},
      "targets": [{"expr": "time() - node_boot_time_seconds", "refId": "A"}],
      "fieldConfig": {
        "defaults": {"unit": "s", "color": {"mode": "fixed", "fixedColor": "blue"}}
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "type": "row",
      "title": "Spark host — CPU, memory, network, disk",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU usage by mode",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 10,
      "datasource": {"type": "prometheus", "uid": "cfhyzy3slg1dsf"},
      "targets": [
        {
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[$__rate_interval])) / on() group_left sum(rate(node_cpu_seconds_total[$__rate_interval])) * 100",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {"drawStyle": "line", "fillOpacity": 30, "stacking": {"mode": "normal"}}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}}
    },
    {
      "type": "timeseries",
      "title": "Memory breakdown",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 11,
      "datasource": {"type": "prometheus", "uid": "cfhyzy3slg1dsf"},
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemFree_bytes - node_memory_Buffers_bytes - node_memory_Cached_bytes - node_memory_SReclaimable_bytes",
          "legendFormat": "Used",
          "refId": "A"
        },
        {"expr": "node_memory_Buffers_bytes", "legendFormat": "Buffers", "refId": "B"},
        {"expr": "node_memory_Cached_bytes + node_memory_SReclaimable_bytes", "legendFormat": "Cache", "refId": "C"},
        {"expr": "node_memory_MemFree_bytes", "legendFormat": "Free", "refId": "D"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"drawStyle": "line", "fillOpacity": 40, "stacking": {"mode": "normal"}}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}}
    },
    {
      "type": "timeseries",
      "title": "Network throughput",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "id": 12,
      "datasource": {"type": "prometheus", "uid": "cfhyzy3slg1dsf"},
      "targets": [
        {
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[$__rate_interval]))",
          "legendFormat": "RX {{device}}",
          "refId": "A"
        },
        {
          "expr": "-sum by (device) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[$__rate_interval]))",
          "legendFormat": "TX {{device}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "fillOpacity": 20}}
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}}
    },
    {
      "type": "timeseries",
      "title": "Disk I/O",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "id": 13,
      "datasource": {"type": "prometheus", "uid": "cfhyzy3slg1dsf"},
      "targets": [
        {
          "expr": "sum by (device) (rate(node_disk_read_bytes_total{device!~\"loop.*|dm-.*\"}[$__rate_interval]))",
          "legendFormat": "read {{device}}",
          "refId": "A"
        },
        {
          "expr": "-sum by (device) (rate(node_disk_written_bytes_total{device!~\"loop.*|dm-.*\"}[$__rate_interval]))",
          "legendFormat": "write {{device}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "fillOpacity": 20}}
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}}
    },
    {
      "type": "table",
      "title": "Disk space by mount",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 22},
      "id": 14,
      "datasource": {"type": "prometheus", "uid": "cfhyzy3slg1dsf"},
      "targets": [
        {
          "expr": "node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"}",
          "legendFormat": "{{mountpoint}}",
          "refId": "size",
          "format": "table",
          "instant": true
        },
        {
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"}",
          "legendFormat": "{{mountpoint}}",
          "refId": "avail",
          "format": "table",
          "instant": true
        },
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"})",
          "legendFormat": "{{mountpoint}}",
          "refId": "used_pct",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {"byField": "mountpoint", "mode": "outer"}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true, "Time 2": true, "Time 3": true,
              "__name__ 1": true, "__name__ 2": true, "__name__ 3": true,
              "device 1": true, "device 2": true, "device 3": true,
              "fstype 1": true, "fstype 2": true, "fstype 3": true,
              "instance 1": true, "instance 2": true, "instance 3": true,
              "job 1": true, "job 2": true, "job 3": true
            },
            "renameByName": {
              "mountpoint": "Mount",
              "Value #size": "Total",
              "Value #avail": "Available",
              "Value #used_pct": "Used %"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto"}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Total"}, "properties": [{"id": "unit", "value": "bytes"}]},
          {"matcher": {"id": "byName", "options": "Available"}, "properties": [{"id": "unit", "value": "bytes"}]},
          {
            "matcher": {"id": "byName", "options": "Used %"},
            "properties": [
              {"id": "unit", "value": "percent"},
              {"id": "decimals", "value": 1},
              {
                "id": "custom.cellOptions",
                "value": {"type": "color-background", "mode": "gradient"}
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "green", "value": null},
                    {"color": "yellow", "value": 70},
                    {"color": "red", "value": 85}
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {"showHeader": true}
    },
