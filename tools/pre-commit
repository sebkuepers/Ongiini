#!/usr/bin/env bash
# Git pre-commit hook — regenerates product.md when any website page is
# staged for commit, then stages the regenerated files so they ship in
# the same commit as the website change.
#
# Install with:
#
#     ln -sf "$(pwd)/tools/pre-commit" .git/hooks/pre-commit
#
# (Re-run any time you `git clone` the repo fresh.)

set -euo pipefail

# Resolve repo root so the hook works regardless of cwd.
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Check if any HTML file under website/ is part of this commit. If not,
# the product knowledge can't have changed — skip the regeneration so
# the hook stays out of the way on non-website commits.
if ! git diff --cached --name-only | grep -qE '^website/.*\.html$'; then
  exit 0
fi

echo "pre-commit: website HTML changed, regenerating product.md..."
python3 tools/build_product_knowledge.py

# Stage the regenerated files so the commit carries them.
git add webhook/app/knowledge/product.md website/product.md

echo "pre-commit: regenerated and staged product.md"
